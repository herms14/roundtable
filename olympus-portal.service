[Unit]
Description=Roundtable - Portal (agent dashboard on :8088)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes-admin
WorkingDirectory=/home/hermes-admin/olympus
ExecStart=/usr/bin/python3 -u /home/hermes-admin/olympus/portal.py
Restart=always
RestartSec=5
Environment=PATH=/home/hermes-admin/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
