[Unit]
Description=Roundtable - Gideon COO and Enterprise Architect (routing, approvals, budget, lead briefings)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes-admin
WorkingDirectory=/home/hermes-admin/olympus
ExecStart=/usr/bin/python3 -u /home/hermes-admin/olympus/boss.py
Restart=always
RestartSec=10
KillMode=process
Environment=PATH=/home/hermes-admin/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
