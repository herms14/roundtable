{
  "about": "Torrent-managed Omada Gateway ACLs (LAN->LAN only). Source of truth for netops.py acl. Human view: Obsidian '64 - VLAN ACL Rule Set'. Rules are created in 'order'; 'phase' gates rollout (acl apply <phase> includes every enabled rule with phase <= it).",
  "version": 8,
  "vlans": {"1": "192.168.0.0/24", "10": "192.168.10.0/24", "20": "192.168.20.0/24", "30": "192.168.30.0/24",
            "40": "192.168.40.0/24", "50": "192.168.50.0/24",
            "80": "192.168.80.0/24", "90": "192.168.90.0/24"},
  "groups": {
    "G_ADMIN_PC": ["192.168.10.10"],
    "G_IOT_MANAGERS": ["192.168.10.10"],
    "G_PIHOLE": ["192.168.90.53", "192.168.90.60"],
    "G_OMADA_CTRL": ["192.168.0.101"],
    "G_PVE": ["192.168.20.20", "192.168.20.21", "192.168.20.22"],
    "G_NAS": ["192.168.20.32"],
    "G_BACKUP": ["192.168.20.50"],
    "G_ANSIBLE": ["192.168.20.30"],
    "G_SRE": ["192.168.40.16"],
    "G_MONITOR": ["192.168.40.13"],
    "G_HELIOS": ["192.168.40.14"],
    "G_DASH": ["192.168.40.12", "192.168.40.27"],
    "G_TRAEFIK": ["192.168.40.20"],
    "G_NFS_CLIENTS": ["192.168.40.11", "192.168.40.22"],
    "G_SYSLOG": ["192.168.40.5", "192.168.40.13"],
    "G_RUNNER": ["192.168.40.24"],
    "G_HA": ["192.168.40.25"]
  },
  "rules": [
    {"order": 1, "name": "ALLOW-DNS-PiHole", "action": "permit", "src": {"nets": [1, 10, 20, 30, 40, 50, 80, 90]}, "dst": {"groups": ["G_PIHOLE"]}, "proto": "tcpudp", "ports": ["53"], "log": true, "phase": 3, "note": "Logging on by owner choice 2026-10-15. Guest (50) included on owner request 2026-10-15: DNS to Pi-hole only; everything else from Guest is denied by DENY-Guest-Out. v8 2026-10-18: G_PIHOLE is both DNS servers (Technitium .60 primary, Pi-hole .53 secondary); names kept so the rollout updates the group instead of recreating rules"},
    {"order": 2, "name": "ALLOW-Omada-Adopt", "action": "permit", "src": {"nets": [90]}, "dst": {"groups": ["G_OMADA_CTRL"]}, "proto": "tcpudp", "ports": ["29810-29817"], "log": false, "phase": 4},
    {"order": 3, "name": "ALLOW-Omada-Manage", "action": "permit", "src": {"groups": ["G_OMADA_CTRL"]}, "dst": {"nets": [90]}, "proto": "all", "log": false, "phase": 4},
    {"order": 4.1, "name": "ALLOW-Syslog-Devices", "action": "permit", "src": {"nets": [90]}, "dst": {"groups": ["G_SYSLOG"]}, "proto": "udp", "ports": ["514", "5514"], "log": false, "phase": 4},
    {"order": 4.2, "name": "ALLOW-Syslog-Controller", "action": "permit", "src": {"groups": ["G_OMADA_CTRL"]}, "dst": {"groups": ["G_SYSLOG"]}, "proto": "udp", "ports": ["514", "5514"], "log": false, "phase": 4},
    {"order": 5, "name": "ALLOW-Admin-Infra", "action": "permit", "src": {"groups": ["G_ADMIN_PC"]}, "dst": {"nets": [1, 20, 40, 90]}, "proto": "all", "log": true, "phase": 2},
    {"order": 6, "name": "ALLOW-Admin-RDP-HyperV", "action": "permit", "src": {"groups": ["G_ADMIN_PC"]}, "dst": {"nets": [80]}, "proto": "tcpudp", "ports": ["3389"], "log": true, "phase": 2},
    {"order": 7, "name": "ALLOW-IoT-Managers", "action": "permit", "src": {"groups": ["G_IOT_MANAGERS"]}, "dst": {"nets": [30]}, "proto": "all", "log": true, "phase": 3},
    {"order": 8, "name": "ALLOW-HA-IoT", "action": "permit", "src": {"groups": ["G_HA"]}, "dst": {"nets": [30]}, "proto": "all", "log": true, "phase": 3, "enabled": false, "note": "DECIDE: only if Home Assistant controls IoT devices locally"},
    {"order": 9, "name": "ALLOW-Backup-All", "action": "permit", "src": {"groups": ["G_BACKUP"]}, "dst": {"nets": [40, 80, 90]}, "proto": "all", "log": true, "phase": 4},
    {"order": 10, "name": "ALLOW-NFS-Clients", "action": "permit", "src": {"groups": ["G_NFS_CLIENTS"]}, "dst": {"groups": ["G_NAS"]}, "proto": "tcpudp", "ports": ["111", "2049"], "log": false, "phase": 4},
    {"order": 13, "name": "ALLOW-Prod-to-HyperV", "action": "permit", "src": {"nets": [40]}, "dst": {"nets": [80]}, "proto": "all", "log": false, "phase": 4},
    {"order": 14, "name": "ALLOW-HyperV-to-Prod", "action": "permit", "src": {"nets": [80]}, "dst": {"nets": [40]}, "proto": "all", "log": false, "phase": 4},
    {"order": 15, "name": "ALLOW-Ansible-Targets", "action": "permit", "src": {"groups": ["G_ANSIBLE"]}, "dst": {"nets": [40, 90]}, "proto": "all", "log": true, "phase": 4},
    {"order": 16, "name": "ALLOW-Ansible-Omada", "action": "permit", "src": {"groups": ["G_ANSIBLE"]}, "dst": {"groups": ["G_OMADA_CTRL"]}, "proto": "tcp", "ports": ["443"], "log": false, "phase": 4},
    {"order": 17.1, "name": "ALLOW-SRE-Agent", "action": "permit", "src": {"groups": ["G_SRE"]}, "dst": {"nets": [20, 90]}, "proto": "all", "log": true, "phase": 4},
    {"order": 17.2, "name": "ALLOW-SRE-Omada", "action": "permit", "src": {"groups": ["G_SRE"]}, "dst": {"groups": ["G_OMADA_CTRL"]}, "proto": "all", "log": true, "phase": 4},
    {"order": 18, "name": "ALLOW-PVE-Tailscale", "action": "permit", "src": {"groups": ["G_PVE"]}, "dst": {"nets": [40, 90]}, "proto": "all", "log": true, "phase": 4},
    {"order": 19.1, "name": "ALLOW-Monitoring-TCP", "action": "permit", "src": {"groups": ["G_MONITOR"]}, "dst": {"nets": [20, 90]}, "proto": "tcp", "ports": ["22", "80", "443", "5000-5001", "8006-8007", "9100-9101", "9202", "9274"], "log": false, "phase": 4},
    {"order": 19.2, "name": "ALLOW-Monitoring-SNMP", "action": "permit", "src": {"groups": ["G_MONITOR"]}, "dst": {"nets": [20, 90]}, "proto": "udp", "ports": ["161"], "log": false, "phase": 4},
    {"order": 19.3, "name": "ALLOW-Monitoring-ICMP", "action": "permit", "src": {"groups": ["G_MONITOR"]}, "dst": {"nets": [20, 90]}, "proto": "icmp", "log": false, "phase": 4},
    {"order": 19.4, "name": "ALLOW-Monitoring-Omada", "action": "permit", "src": {"groups": ["G_MONITOR"]}, "dst": {"groups": ["G_OMADA_CTRL"]}, "proto": "tcp", "ports": ["443"], "log": false, "phase": 4},
    {"order": 20, "name": "ALLOW-Helios", "action": "permit", "src": {"groups": ["G_HELIOS"]}, "dst": {"groups": ["G_PVE", "G_NAS", "G_OMADA_CTRL"]}, "proto": "tcp", "ports": ["22", "443", "5000-5001", "8006"], "log": true, "phase": 4},
    {"order": 21, "name": "ALLOW-Dashboards", "action": "permit", "src": {"groups": ["G_DASH"]}, "dst": {"groups": ["G_PVE", "G_BACKUP", "G_NAS", "G_PIHOLE"]}, "proto": "tcp", "ports": ["80", "443", "5000-5001", "5380", "8006", "8007"], "log": false, "phase": 4},
    {"order": 22, "name": "ALLOW-Traefik-Backends", "action": "permit", "src": {"groups": ["G_TRAEFIK"]}, "dst": {"groups": ["G_PVE", "G_BACKUP", "G_PIHOLE", "G_OMADA_CTRL"]}, "proto": "tcp", "ports": ["80", "443", "5380", "8006", "8007"], "log": false, "phase": 4},
    {"order": 23, "name": "ALLOW-Runner-Deploy", "action": "permit", "src": {"groups": ["G_RUNNER"]}, "dst": {"nets": [20]}, "proto": "tcp", "ports": ["22"], "log": true, "phase": 4, "enabled": false, "note": "DECIDE: only if GitLab pipelines deploy to VLAN 20 hosts"},
    {"order": 24, "name": "ALLOW-Internal-Services", "action": "permit", "src": {"nets": [10]}, "dst": {"nets": [1, 20, 40, 90]}, "proto": "all", "log": true, "phase": 2},
    {"order": 25, "name": "DENY-to-Internal", "action": "deny", "src": {"nets": [1, 20, 30, 40, 50, 80, 90]}, "dst": {"nets": [10]}, "proto": "all", "log": true, "phase": 2},
    {"order": 26, "name": "DENY-IoT-Out", "action": "deny", "src": {"nets": [30]}, "dst": {"nets": [1, 20, 40, 50, 80, 90]}, "proto": "all", "log": true, "phase": 3},
    {"order": 27, "name": "DENY-Guest-Out", "action": "deny", "src": {"nets": [50]}, "dst": {"nets": [1, 10, 20, 30, 40, 80, 90]}, "proto": "all", "log": true, "phase": 3},
    {"order": 30, "name": "DENY-to-IoT", "action": "deny", "src": {"nets": [1, 10, 20, 40, 50, 80, 90]}, "dst": {"nets": [30]}, "proto": "all", "log": true, "phase": 3},
    {"order": 32, "name": "DENY-to-HyperV", "action": "deny", "src": {"nets": [1, 10, 20, 90]}, "dst": {"nets": [80]}, "proto": "all", "log": true, "phase": 4},
    {"order": 34, "name": "DENY-Prod-Rest", "action": "deny", "src": {"nets": [40]}, "dst": {"nets": [1, 20, 90]}, "proto": "all", "log": true, "phase": 4},
    {"order": 35, "name": "DENY-Homelab-Rest", "action": "deny", "src": {"nets": [20]}, "dst": {"nets": [1, 40, 90]}, "proto": "all", "log": true, "phase": 4},
    {"order": 36, "name": "DENY-Mgmt-Rest", "action": "deny", "src": {"nets": [90]}, "dst": {"nets": [1, 20, 40]}, "proto": "all", "log": true, "phase": 4},
    {"order": 37, "name": "DENY-HyperV-Rest", "action": "deny", "src": {"nets": [80]}, "dst": {"nets": [1, 20, 90]}, "proto": "all", "log": true, "phase": 4},
    {"order": 38, "name": "DENY-Default-Rest", "action": "deny", "src": {"nets": [1]}, "dst": {"nets": [20, 40, 90]}, "proto": "all", "log": true, "phase": 4}
  ]
